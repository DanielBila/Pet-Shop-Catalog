using PetShopCatalog.Entities;

namespace PetShopCatalog.Service
{
   
    internal class Connection
    {
        
        public void ListPrint<T>(List<T> list)
        {
            if (list.Count <= 0)
            {
                Console.WriteLine("The list is empty.");
                return;
            }

            // Cabeçalho simples para facilitar leitura no console
            Console.WriteLine("Type   Name  Age Sex Race");
            for (int i = 0; i < list.Count; i++)
            {
                // Cada item é impresso; espera-se que o tipo T tenha
                // uma implementação de ToString() amigável.
                Console.WriteLine(list[i]);
            }
        }

        // Cria e adiciona um novo IAnimal (Dog ou Cat) à lista fornecida.
        // Interage com o usuário via Console para coletar os dados.
        public void AddAnimal(List<IAnimal> values)
        {
            Console.WriteLine("Enter the type of animal (dog/cat): ");
            // Normaliza a entrada e valida apenas 'dog' ou 'cat'
            string animalType = Console.ReadLine().ToLower() switch
            {
                "dog" => "dog",
                "cat" => "cat",
                _ => "invalido"
            };

            if (animalType == "invalido")
            {
                // Entrada inválida: informa o usuário e aborta a operação.
                Console.WriteLine("Invalid animal type. Please enter 'dog' or 'cat'.");
                Console.ReadLine();
                return;
            }

            // Coleta dos demais campos do animal.
            Console.WriteLine("Enter the name: ");
            string name = Console.ReadLine();
            Console.WriteLine($"Enter the age of {name}: ");
            int age = int.Parse(Console.ReadLine());
            Console.WriteLine($"Enter the sex of {name}: ");
            string sex = Console.ReadLine();
            Console.WriteLine($"Enter the race of {name}: ");
            string race = Console.ReadLine();

            // Cria a instância correta com base no tipo informado.
            IAnimal newAnimal = animalType.ToLower() switch
            {
                "dog" => new Dog(name, age, sex, race, DateTime.Now),
                "cat" => new Cat(name, age, sex, race, DateTime.Now),
            };

            // Adiciona à lista passada por referência.
            values.Add(newAnimal);
        }

        // Remove um animal da lista por índice informado pelo usuário.
        // Mostra a lista atual com índices legíveis (1-based) e valida a escolha.
        public void RemoveAnimalByIndex(List<IAnimal> values)
        {
            if (values.Count == 0)
            {
                Console.WriteLine("The list is empty.");
                Console.ReadLine();
                return;
            }

            Console.WriteLine("Current animals:");
            for (int i = 0; i < values.Count; i++)
            {
                // Exibe cada animal com número (1-based) para facilitar remoção
                Console.WriteLine($"{i + 1}. {values[i].Name} ({values[i].Race}, {values[i].Age} anos)");
            }

            Console.WriteLine("Enter the number of the animal to remove: ");
            int index = int.Parse(Console.ReadLine()) - 1; // converte para 0-based

            if (index < 0 || index >= values.Count)
            {
                Console.WriteLine("Invalid index.");
                return;
            }

            // Confirmação simples e remoção do item selecionado.
            Console.WriteLine($"{values[index].Name} removed successfully!");
            values.RemoveAt(index);
        }

        // Exibe o menu principal (representado por ToString) quando a instância
        // for convertida para string. Mantido simples para uso no console.
        public override string ToString()
        {
            return """
                TotalList - 1
                Add Animal - 2
                Remove Animal - 3
                Exit - 9
                """;
        }
    }
}
